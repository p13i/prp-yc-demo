# QM (p13i/qm-yc-hackathon) against the prima.cpp ring. No cloud keys.
# Written by scripts/demo_qm.sh; __MASTER__, __PORT__ and __SECRET__
# are substituted at write time.
HARNESS=pi
HARNESS_SECURITY_POSTURE=auto
HARNESS_SHARING_POSTURE=isolated
CODEX_AUTH_FILE=

ORG_ID=acme
CORE_ORG_ID=acme
PORT=__PORT__
SESSION_STORE=memory
RUN_STORE=memory
# Core HTTP API without the portal/web-ui signing path (curl-driven turns).
ALLOW_UNAUTHENTICATED_CORE=1
CORE_SIGNING_SECRET=

# Mesh model routing. QM's built-in OpenRouter provider speaks OpenAI Chat
# Completions; OPENROUTER_BASE_URL redirects it to the ring master's compat
# proxy, which strips tools/tool_choice/response_format and serves the model
# as qwen2.5-7b. The key is a non-empty placeholder that the proxy ignores.
OPENROUTER_API_KEY=mesh-local-placeholder
OPENROUTER_BASE_URL=http://__MASTER__:8088/v1
MODEL_PROVIDER=openrouter
PI_MODEL=qwen/qwen-2.5-7b-instruct
# Presence check only (scripts/dev/lib/envctx.ts selects the pi harness when
# this is set). MODEL_PROVIDER=openrouter keeps every turn off Anthropic.
ANTHROPIC_API_KEY=placeholder-not-used

CAPABILITY_SECRET=__SECRET__
CAPABILITY_TOKEN_COMPRESSION=0
PORTAL_IDENTITY_SECRET=__SECRET__
CONNECTOR_SECRET_KEY=__SECRET__
SKILL_SIGNING_SECRET=__SECRET__
INBOX_USERS=

RATE_LIMIT_PER_WINDOW=60
RATE_LIMIT_WINDOW_MS=60000
BUDGET_USD_PER_WINDOW=25
ORG_BUDGET_USD_PER_WINDOW=100
BUDGET_WINDOW_MS=86400000

DEV_INSTANCE_NO_SLACK=1
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
PUBLIC_WEB_URL=http://localhost:8129
SHUTDOWN_DRAIN_MS=2000
# Allow in-memory stores when there is no DATABASE_URL and no Docker Postgres.
DEV_INSTANCE_ALLOW_MEMORY=1
SLACK_CONTEXT_SOURCE=live
SLACK_HISTORY_LIMIT=
